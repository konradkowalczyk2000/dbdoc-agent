# ---------------------------------------------------------------- Database
# Option A: SQL login (use a read-only user, see README)
AZURE_SQL_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:myserver.database.windows.net,1433;Database=mydb;Uid=dbdoc_reader;Pwd=CHANGE_ME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;ApplicationIntent=ReadOnly

# Option B: Entra ID, interactive browser login
# AZURE_SQL_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:myserver.database.windows.net,1433;Database=mydb;Authentication=ActiveDirectoryInteractive;UID=you@company.com;Encrypt=yes;ApplicationIntent=ReadOnly

# Option C: any SQLAlchemy URL instead (e.g. for local tests)
# DB_URL=sqlite:///test.db

# ---------------------------------------------------------------- LLM
# Provider: anthropic | azure_openai | openai | none
DBDOC_PROVIDER=anthropic
# Language of the descriptions, e.g. Polish, Arabic, English
DBDOC_LANGUAGE=English

# Claude
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Azure OpenAI (leave the key empty to log in with Entra ID / az login)
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
