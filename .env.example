# Copy to .env in the project folder (next to the dbdoc folder) and fill in.
# One setting per line, no quotes around values. Values here override variables
# already set in the terminal. Lines starting with # are ignored.

# ================================================================ Database
# Pick ONE way to connect: A, B, C or D. Keep only one AZURE_SQL_ODBC line active.

# --- Option A (recommended): Microsoft Entra ID with MFA via azure-identity.
# The connection string must NOT contain Authentication, Uid or Pwd.
# Sign-in mode: browser | device | cli | default  (the --auth option overrides it)
AZURE_SQL_AUTH=browser
AZURE_SQL_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:myserver.database.windows.net,1433;Database=mydb;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;ApplicationIntent=ReadOnly

# Tenant of the SQL server. Needed if your account is in several tenants or is a guest.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Only for AZURE_SQL_AUTH=default with a service principal (unattended runs).
# Also needs AZURE_TENANT_ID above. A managed identity needs none of these.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Option B: SQL login (use a read-only user, see README). Leave AZURE_SQL_AUTH empty.
# AZURE_SQL_AUTH=
# AZURE_SQL_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:myserver.database.windows.net,1433;Database=mydb;Uid=dbdoc_reader;Pwd=CHANGE_ME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;ApplicationIntent=ReadOnly

# --- Option C: Entra ID handled by the ODBC driver itself. Leave AZURE_SQL_AUTH empty.
# AZURE_SQL_AUTH=
# AZURE_SQL_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:myserver.database.windows.net,1433;Database=mydb;Authentication=ActiveDirectoryInteractive;UID=you@company.com;Encrypt=yes;ApplicationIntent=ReadOnly

# --- Option D: any SQLAlchemy URL instead (e.g. local tests). Used only if AZURE_SQL_ODBC is not set.
# DB_URL=sqlite:///test.db

# ================================================================ LLM
# Provider: anthropic | azure_openai | openai | none   (--provider overrides it)
DBDOC_PROVIDER=anthropic
# Language of the descriptions, e.g. Polish   (--language overrides it)
DBDOC_LANGUAGE=English

# --- Claude (DBDOC_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Azure OpenAI (DBDOC_PROVIDER=azure_openai)
# Leave the key empty to sign in with Entra ID instead. That uses DefaultAzureCredential
# (e.g. `az login`), not AZURE_SQL_AUTH, and needs the "Cognitive Services OpenAI User" role.
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

